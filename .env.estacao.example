PAPEL=estacao
PORTA=3000
# Porta HTTP em que os fotógrafos acessam a estação pela rede local.
PORTA_LAN=80

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=fotos
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=fotos_estacao

REDIS_URL=redis://redis:6379
REDIS_PREFIXO=fotos:estacao:

# Segredo compartilhado com a VPS, igual nos dois .env. Gere com: openssl rand -hex 32
ESTACAO_CHAVE=
VPS_URL=https://admin-fotos.exemplo.com.br

# Pastas locais do pipeline de ingestão.
RAIZ_ORIGINAIS=/data/originais
RAIZ_PUBLICAR=/data/publicar
RAIZ_MARCAS=/data/marcas

# URL do vision-service (modo gpu) desta estação.
VISION_URL=http://vision:8000
# Fotos processadas ao mesmo tempo (hash → original → rostos → derivados). A maior parte do tempo é espera pelo vision.
WORKER_CONCORRENCIA=16

# Fotos geradas ao mesmo tempo na etapa de derivados (padrão: núcleos - 2).
SHARP_CONCORRENCIA=6

# Painel da estação (/#/estacao): assina a sessão do operador. Sem ele, o login do painel se
# recusa. Gere com: openssl rand -hex 32
OPERADOR_SEGREDO=

# Endereços que entram nos links e QR de upload dos fotógrafos. O da rede local é o que o
# celular do fotógrafo alcança no evento; o do túnel, para quem manda de longe.
ENDERECO_LAN=http://192.168.0.10
ENDERECO_TUNEL=https://estacao-fotos.exemplo.com.br

# Tamanho de cada pedaço do envio, em MB.
UPLOAD_PEDACO_MB=8
