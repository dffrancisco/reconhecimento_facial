{
    "compilerOptions": {
        "target": "ES2023",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "jsx": "preserve",
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "noEmit": true,
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "types": ["vite/client"]
    },
    "include": ["src/**/*.ts", "src/**/*.vue", "*.config.ts"]
}
