PAPEL=vps
PORTA=3000

# Hosts atendidos pelo Traefik (proxy da Cloudflare na frente, SSL "Full (strict)").
DOMINIO_PARTICIPANTE=fotos.exemplo.com.br
# Um nível só abaixo do domínio: o certificado gratuito da Cloudflare não cobre dois níveis.
DOMINIO_ADMIN=admin-fotos.exemplo.com.br
PORTA_HTTP=80
PORTA_HTTPS=443

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=fotos
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=fotos_vps

REDIS_URL=redis://redis:6379
REDIS_PREFIXO=fotos:vps:

# Segredo compartilhado com a estação, igual nos dois .env. Gere com: openssl rand -hex 32
ESTACAO_CHAVE=
# Assinatura dos links de arquivo (nginx secure_link). Gere com: openssl rand -hex 32
ARQUIVO_SEGREDO=
# Assinatura dos tokens de sessão do operador. Gere com: openssl rand -hex 32
OPERADOR_SEGREDO=

# Selfies processadas ao mesmo tempo no vision (CPU). Vazio = núcleos - 1.
SELFIE_CONCORRENCIA=

# Pasta onde ficam os PNGs de marca d'água enviados pelo admin.
RAIZ_MARCAS=/data/marcas

# Pasta onde ficam as fotos publicadas (web, thumb, prévia).
RAIZ_FOTOS=/data/fotos

# Validade dos links assinados de foto e ZIP, em segundos.
ARQUIVO_LINK_VALIDADE_S=3600

# Buscas por IP a cada 10 minutos.
BUSCA_LIMITE_IP=10
# A VPS fica atrás do Traefik (e da Cloudflare): sem isso, o limite por IP conta o IP do
# proxy e vira um teto único para todos os participantes juntos. Exige firewall aceitando
# só a Cloudflare, senão o cabeçalho pode ser forjado.
CONFIAR_CLOUDFLARE=true

# O vision da VPS roda em modo selfie-cpu (embedding da selfie).
VISION_URL=http://vision:8000
# Pasta tmpfs onde a selfie fica durante a busca, e só durante ela.
RAIZ_SELFIES=/data/selfies

# Pasta onde ficam os ZIPs montados para download.
RAIZ_ZIPS=/data/zips
